      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Bold'>Which Coffee Sells the Most at What Time?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_sales_receipts' name='federated.1095z1218k4ycj13blhhl0c8ulh0' />
          </datasources>
          <datasource-dependencies datasource='federated.1095z1218k4ycj13blhhl0c8ulh0'>
            <column caption='Hour of Day' datatype='datetime' name='[Calculation_0990667820412931]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MAKETIME(DATEPART(&apos;hour&apos;, [transaction_dt]), 0, 0)' />
            </column>
            <column caption='Line Item Amount' datatype='real' name='[line_item_amount]' role='measure' type='quantitative' />
            <column-instance column='[product]' derivation='None' name='[none:product:nk]' pivot='key' type='nominal' />
            <column-instance column='[product_category]' derivation='None' name='[none:product_category:nk]' pivot='key' type='nominal' />
            <column caption='Product' datatype='string' name='[product]' role='dimension' type='nominal' />
            <column caption='Product Category' datatype='string' name='[product_category]' role='dimension' type='nominal' />
            <column caption='Quantity' datatype='integer' name='[quantity]' role='measure' type='quantitative' />
            <column-instance column='[line_item_amount]' derivation='Sum' name='[sum:line_item_amount:qk]' pivot='key' type='quantitative' />
            <column-instance column='[quantity]' derivation='Sum' name='[sum:quantity:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0990667820412931]' derivation='Hour-Trunc' name='[thr:Calculation_0990667820412931:ok]' pivot='key' type='ordinal' />
            <column caption='Transaction Dt' datatype='datetime' name='[transaction_dt]' role='dimension' type='ordinal' />
